# AppealMate environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ElevenLabs Text-to-Speech.
# Get it at https://elevenlabs.io/app/settings/api-keys  (Profile -> API Keys)
# Without it, AppealMate still runs: Aria's lines appear as captions and the
# browser's own speech recognition handles the caller. Audio just stays silent.
ELEVENLABS_API_KEY=

# Optional: override the default voice (see README for voice IDs).
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: server port (default 8080)
# PORT=8080
